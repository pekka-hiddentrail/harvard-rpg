{
  "name": "harvard-rpg",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test \"packages/*/test/*.test.ts\"",
    "lint": "eslint . --ext .ts,.tsx",
    "server": "tsx packages/server/src/index.ts",
    "balance": "tsx scripts/balance.ts",
    "gui": "npm run dev --workspace=@harvard/client",
    "gui:character": "npm run dev --workspace=@harvard/client -- --open /?screen=character",
    "gui:build": "npm run build --workspace=@harvard/client",
    "gui:test": "npm run test --workspace=@harvard/client"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "tsx": "^4.19.1",
    "typescript-eslint": "^8.43.0",
    "typescript": "^5.6.2"
  }
}
